# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Only on the server (Vercel env). Used by the GFF auto-sync.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string. Vercel sends it to /api/sync-gff automatically.
CRON_SECRET=change-me-to-a-long-random-string
# GFF league page to sync (season 44 = 2026, league 4 = ლიგა 4)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
GFF_SEASON=44
GFF_LEAGUE=4
